  427|    179|        self.inner.rx_fields.with_mut(|rx_fields_ptr| {
  428|       |            let rx_fields = unsafe { &mut *rx_fields_ptr };
  429|       |
  430|       |            macro_rules! try_recv {
  431|       |                () => {
