  462|       |            let mut park = CachedParkThread::new();
  463|       |            let waker = park.waker().unwrap();
  464|       |            loop {
  465|       |                self.inner.rx_waker.register_by_ref(&waker);
  466|       |                // It is possible that the problematic send has now completed,
  467|       |                // so we have to check for messages again.
  468|       |                try_recv!();
