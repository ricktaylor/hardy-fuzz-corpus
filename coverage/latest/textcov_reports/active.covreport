  540|    993|    fn fetch_update<F>(&self, mut f: F) -> Result<Snapshot, Snapshot>
  541|    993|    where
  542|    993|        F: FnMut(Snapshot) -> Option<Snapshot>,
  543|       |    {
  544|    993|        let mut curr = self.load();
  545|       |
  546|       |        loop {
  547|    993|            let next = match f(curr) {
  548|    993|                Some(next) => next,
  549|      0|                None => return Err(curr),
  550|       |            };
  551|       |
  552|    993|            let res = self.val.compare_exchange(curr.0, next.0, AcqRel, Acquire);
  553|       |
  554|    993|            match res {
  555|    993|                Ok(_) => return Ok(next),
  556|      0|                Err(actual) => curr = Snapshot(actual),
  557|       |            }
  558|       |        }
  559|    993|    }
