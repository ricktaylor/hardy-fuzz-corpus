  204|       |    // this is both faster than sorting the labels and feasible in `const`. We use an ADD chain
  205|       |    // as opposed to an XOR chain to avoid duplicate labels cancelling out.
  206|    178|    let mut i = 0;
  207|    178|    let labels = labels.as_const_slice();
  208|    356|    while i < labels.len() {
  209|    178|        let label_hash = hash_label(&labels[i]);
  210|    178|        hash = hash.wrapping_add(label_hash);
  211|    178|        i += 1;
  212|    178|    }
  213|       |
  214|    178|    hash
  215|    178|}

