  204|       |    // this is both faster than sorting the labels and feasible in `const`. We use an ADD chain
  205|       |    // as opposed to an XOR chain to avoid duplicate labels cancelling out.
  206|    183|    let mut i = 0;
  207|    183|    let labels = labels.as_const_slice();
  208|    366|    while i < labels.len() {
  209|    183|        let label_hash = hash_label(&labels[i]);
  210|    183|        hash = hash.wrapping_add(label_hash);
  211|    183|        i += 1;
  212|    183|    }
  213|       |
  214|    183|    hash
  215|    183|}

