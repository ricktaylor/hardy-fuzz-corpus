  193|    872|    fn poll_inner(&self) -> PollFuture {
  194|       |        use super::state::{TransitionToIdle, TransitionToRunning};
  195|       |
  196|    872|        match self.state().transition_to_running() {
  197|       |            TransitionToRunning::Success => {
  198|       |                // Separated to reduce LLVM codegen
  199|       |                fn transition_result_to_poll_future(result: TransitionToIdle) -> PollFuture {
  200|       |                    match result {
  201|       |                        TransitionToIdle::Ok => PollFuture::Done,
  202|       |                        TransitionToIdle::OkNotified => PollFuture::Notified,
  203|       |                        TransitionToIdle::OkDealloc => PollFuture::Dealloc,
  204|       |                        TransitionToIdle::Cancelled => PollFuture::Complete,
  205|       |                    }
  206|       |                }
  207|    872|                let header_ptr = self.header_ptr();
  208|    872|                let waker_ref = waker_ref::<S>(&header_ptr);
  209|    872|                let cx = Context::from_waker(&waker_ref);
  210|    872|                let res = poll_future(self.core(), cx);
  211|       |
  212|    872|                if res == Poll::Ready(()) {
  213|       |                    // The future completed. Move on to complete the task.
  214|    436|                    return PollFuture::Complete;
  215|    436|                }
  216|       |
  217|    436|                let transition_res = self.state().transition_to_idle();
  218|    436|                if let TransitionToIdle::Cancelled = transition_res {
  219|      0|                    // The transition to idle failed because the task was
  220|      0|                    // cancelled during the poll.
  221|      0|                    cancel_task(self.core());
  222|    436|                }
  223|    436|                transition_result_to_poll_future(transition_res)
  224|       |            }
  225|       |            TransitionToRunning::Cancelled => {
  226|      0|                cancel_task(self.core());
  227|      0|                PollFuture::Complete
  228|       |            }
  229|      0|            TransitionToRunning::Failed => PollFuture::Done,
  230|      0|            TransitionToRunning::Dealloc => PollFuture::Dealloc,
