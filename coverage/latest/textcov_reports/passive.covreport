  102|  41.7k|    fn find_block(&self, slot_index: usize) -> NonNull<Block<T>> {
  103|       |        // The start index of the block that contains `index`.
  104|  41.7k|        let start_index = block::start_index(slot_index);
  105|       |
  106|       |        // The index offset into the block
  107|  41.7k|        let offset = block::offset(slot_index);
  108|       |
