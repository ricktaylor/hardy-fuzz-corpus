  218|    852|            mio_add(&mut mio, mio::Interest::READABLE);
  219|    852|        }
  220|       |
  221|    852|        if self.is_writable() {
  222|    852|            mio_add(&mut mio, mio::Interest::WRITABLE);
  223|    852|        }
  224|       |
  225|       |        #[cfg(any(target_os = "linux", target_os = "android"))]
  226|    852|        if self.is_priority() {
  227|      0|            mio_add(&mut mio, mio::Interest::PRIORITY);
  228|    852|        }
  229|       |
  230|       |        #[cfg(target_os = "freebsd")]
  231|       |        if self.is_aio() {
  232|       |            mio_add(&mut mio, mio::Interest::AIO);
  233|       |        }
  234|       |
  235|       |        #[cfg(target_os = "freebsd")]
  236|       |        if self.is_lio() {
  237|       |            mio_add(&mut mio, mio::Interest::LIO);
  238|       |        }
  239|       |
  240|    852|        if self.is_error() {
  241|      0|            // There is no error interest in mio, because error events are always reported.
  242|      0|            // But mio interests cannot be empty and an interest is needed just for the registration.
  243|      0|            //
