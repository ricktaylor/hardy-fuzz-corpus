  185|    192|    pub(super) fn with_scheduler<R>(f: impl FnOnce(Option<&scheduler::Context>) -> R) -> R {
  186|    192|        let mut f = Some(f);
  187|    192|        CONTEXT.try_with(|c| {
  188|       |            let f = f.take().unwrap();
  189|       |            if matches!(c.runtime.get(), EnterRuntime::Entered { .. }) {
  190|       |                c.scheduler.with(f)
  191|       |            } else {
  192|       |                f(None)
  193|       |            }
