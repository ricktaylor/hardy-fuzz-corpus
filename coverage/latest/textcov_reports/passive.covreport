  204|       |    // this is both faster than sorting the labels and feasible in `const`. We use an ADD chain
  205|       |    // as opposed to an XOR chain to avoid duplicate labels cancelling out.
  206|    149|    let mut i = 0;
  207|    149|    let labels = labels.as_const_slice();
  208|    298|    while i < labels.len() {
  209|    149|        let label_hash = hash_label(&labels[i]);
  210|    149|        hash = hash.wrapping_add(label_hash);
  211|    149|        i += 1;
  212|    149|    }
  213|       |
  214|    149|    hash
  215|    149|}

