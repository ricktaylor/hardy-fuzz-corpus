   67|      1|    pub fn bind(addr: SocketAddr) -> io::Result<TcpListener> {
   68|      1|        let socket = new_for_addr(addr)?;
   69|       |        #[cfg(any(unix, target_os = "hermit", target_os = "wasi"))]
   70|      1|        let listener = unsafe { TcpListener::from_raw_fd(socket) };
