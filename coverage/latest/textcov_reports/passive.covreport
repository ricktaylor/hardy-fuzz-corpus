  149|      1|    fn create_io_stack(enabled: bool, nevents: usize) -> io::Result<(IoStack, IoHandle, SignalHandle)> {
  150|       |        #[cfg(loom)]
  151|       |        assert!(!enabled);
  152|       |
  153|      1|        let ret = if enabled {
  154|      1|            let (io_driver, io_handle) = crate::runtime::io::Driver::new(nevents)?;
  155|       |
  156|      1|            let (signal_driver, signal_handle) = create_signal_driver(io_driver, &io_handle)?;
  157|      1|            let process_driver = create_process_driver(signal_driver);
  158|       |
  159|      1|            (IoStack::Enabled(process_driver), IoHandle::Enabled(io_handle), signal_handle)
  160|       |        } else {
  161|      0|            let park_thread = ParkThread::new();
  162|      0|            let unpark_thread = park_thread.unpark();
  163|      0|            (IoStack::Disabled(park_thread), IoHandle::Disabled(unpark_thread), Default::default())
  164|       |        };
  165|       |
  166|      1|        Ok(ret)
  167|      1|    }
