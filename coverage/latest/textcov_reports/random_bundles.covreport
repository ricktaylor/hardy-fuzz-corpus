  143|      0|        if last_byte != PAD_BYTE && decode_table[usize::from(last_byte)] == INVALID_VALUE {
  144|      0|            return Err(DecodeError::InvalidByte(input.len() - 1, last_byte).into());
  145|      0|        }
  146|      6|    };
