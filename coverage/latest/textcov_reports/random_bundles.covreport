_RNvNtNtCsiWoy0QryfHy_10hardy_bpv73eid5parse13parse_regname:
   54|    499|fn parse_regname(input: &mut &str) -> ModalResult<DtnNodeId> {
   55|    499|    take_while(0.., |c: char| {
   56|       |        c.is_alphanum()
   57|       |            || matches!(
   58|       |                c,
   59|       |                '-' | '.'
   60|       |                    | '_'
   61|       |                    | '~'
   62|       |                    | '!'
   63|       |                    | '$'
   64|       |                    | '&'
   65|       |                    | '\''
   66|       |                    | '('
   67|       |                    | ')'
   68|       |                    | '*'
   69|       |                    | '+'
   70|       |                    | ','
   71|       |                    | ';'
   72|       |                    | '='
   73|       |                    | '%'
   74|       |            )
   75|       |    })
   76|    499|    .try_map(|v| {
   77|       |        percent_decode_str(v).decode_utf8().map(|s| DtnNodeId {
   78|       |            node_name: s.into_owned().into(),
   79|       |        })
   80|       |    })
   81|    499|    .parse_next(input)
   82|    499|}
_RNvNtNtCsiWoy0QryfHy_10hardy_bpv73eid5parse15parse_dtn_parts:
   96|    499|fn parse_dtn_parts(input: &mut &str) -> ModalResult<Eid> {
   97|    499|    (terminated(parse_regname, "/"), parse_dtn_service_name)
   98|    499|        .map(|(node_name, service_name)| Eid::Dtn {
   99|       |            node_name,
  100|       |            service_name,
  101|       |        })
  102|    499|        .parse_next(input)
  103|    499|}
_RNvNtNtCsiWoy0QryfHy_10hardy_bpv73eid5parse22parse_dtn_service_name:
   84|    125|fn parse_dtn_service_name(input: &mut &str) -> ModalResult<Box<str>> {
   85|    125|    take_while(0.., '\x21'..='\x7e')
   86|    125|        .map(Box::from)
   87|    125|        .parse_next(input)
   88|    125|}
